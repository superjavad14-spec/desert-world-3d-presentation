  markers.forEach(({ label, position, slide }) => {
    const marker = new THREE.Mesh(
      new THREE.BoxGeometry(1, 1, 1),
      new THREE.MeshStandardMaterial({ color: 0xf7d67c, emissive: 0x694a10, flatShading: true })
    );
    marker.position.set(position[0], position[1], position[2]);
    marker.castShadow = true;
    marker.userData = { label, slide };
    worldRoot.add(marker);
    interactiveMarkers.push(marker);
  });

  const sun = new THREE.Mesh(
    new THREE.SphereGeometry(2.5, 18, 18),
    new THREE.MeshBasicMaterial({ color: 0xffd776 })
  );
  sun.position.set(-18, 22, -20);
  scene.add(sun);

  const hemiLight = new THREE.HemisphereLight(0xfff3cc, 0x7e5332, 1.2);
  scene.add(hemiLight);

  const dirLight = new THREE.DirectionalLight(0xffefbc, 1.1);
  dirLight.position.set(15, 25, 10);
  dirLight.castShadow = true;
  dirLight.shadow.mapSize.set(1024, 1024);
  scene.add(dirLight);

  worldPlayer = new THREE.Object3D();
  worldPlayer.position.set(0, 1.4, 10);
  scene.add(worldPlayer);
  camera.position.copy(worldPlayer.position);
  camera.position.y += 1.6;
}

function createStructure({ x, y, z, w, h, d, color, label }) {
  const group = new THREE.Group();
  const base = new THREE.Mesh(
    new THREE.BoxGeometry(w, h, d),
    new THREE.MeshStandardMaterial({ color, flatShading: true })
  );
  base.position.y = y;
  base.castShadow = true;
  base.receiveShadow = true;
  group.add(base);

  const roof = new THREE.Mesh(
    new THREE.BoxGeometry(w + 0.5, 0.8, d + 0.5),
    new THREE.MeshStandardMaterial({ color: 0x8c4a26, flatShading: true })
  );
  roof.position.y = y + h / 2 + 0.7;
  roof.castShadow = true;
  group.add(roof);

  group.position.set(x, 0, z);
  group.userData = { label };
  return { group };
}

function setupScene() {
  scene = new THREE.Scene();
  scene.background = new THREE.Color(0xf4d69f);
  scene.fog = new THREE.Fog(0xf2d39b, 15, 68);

  camera = new THREE.PerspectiveCamera(68, window.innerWidth / window.innerHeight, 0.1, 200);
  camera.rotation.order = "YXZ";
  camera.position.set(0, 2.4, 10);

  renderer = new THREE.WebGLRenderer({ canvas: refs.canvas, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;

  buildWorld();

  bindEvents();
  renderSectionButtons();
  renderComparison();
  renderRegions();
  setMode("presentation");
  showSlide(0);
  setTimeout(() => {
    refs.loadingOverlay.classList.remove("visible");
    refs.loadingOverlay.classList.add("hidden");
  }, 500);
}

function bindEvents() {
  refs.startBtn.addEventListener("click", () => {
    refs.startScreen.classList.add("hidden");
    refs.hud.classList.remove("hidden");
    refs.hud.classList.add("visible");
    state.started = true;
    setMode("presentation");
  });

  refs.exploreBtnFromStart.addEventListener("click", () => {
    refs.startScreen.classList.add("hidden");
    refs.hud.classList.remove("hidden");
    refs.hud.classList.add("visible");
    state.started = true;
    setMode("explore");
  });

  refs.nextBtn.addEventListener("click", () => nextSlide());
  refs.prevBtn.addEventListener("click", () => prevSlide());
  refs.prevTouchBtn.addEventListener("click", () => prevSlide());
  refs.nextTouchBtn.addEventListener("click", () => nextSlide());
  refs.interactTouchBtn.addEventListener("click", () => interactWithNearest());
  refs.menuTouchBtn.addEventListener("click", () => {
    refs.infoPanel.classList.toggle("hidden");
  });

  refs.modeToggleBtn.addEventListener("click", () => {
    setMode(state.mode === "presentation" ? "explore" : "presentation");
  });

  refs.toggleInfoBtn.addEventListener("click", () => {
    refs.infoPanel.classList.toggle("hidden");
    state.infoVisible = !refs.infoPanel.classList.contains("hidden");
  });

  refs.pauseBtn.addEventListener("click", () => {
    state.paused = !state.paused;
    refs.pauseBtn.textContent = state.paused ? "ادامه" : "توقف";
    showToast(state.paused ? "ارائه متوقف شد" : "ارائه از سر گرفته شد");
  });

  refs.fullscreenBtn.addEventListener("click", toggleFullscreen);

  refs.quizRevealBtn.addEventListener("click", () => {
    refs.quizAnswer.classList.toggle("hidden");
  });

  refs.qualitySelect.addEventListener("change", (event) => {
    state.quality = event.target.value;
    const map = { low: 1, medium: 1.5, high: 2 };
    renderer.setPixelRatio(Math.min(window.devicePixelRatio * map[state.quality], 2));
    showToast(`کیفیت گرافیکی: ${event.target.options[event.target.selectedIndex].text}`);
  });

  window.addEventListener("resize", handleResize);
  document.addEventListener("keydown", handleKeyDown);
  document.addEventListener("keyup", handleKeyUp);

  document.addEventListener("pointerlockchange", () => {
    state.pointerLocked = document.pointerLockElement === refs.canvas;
  });

  refs.canvas.addEventListener("click", () => {
    if (state.mode === "explore" && state.inputMode === "desktop" && !state.pointerLocked) {
      refs.canvas.requestPointerLock();
    }
  });

  document.addEventListener("mousemove", (event) => {
    if (state.mode === "explore" && state.inputMode === "desktop" && state.pointerLocked) {
      state.cameraYaw -= event.movementX * 0.0022;
      state.cameraPitch -= event.movementY * 0.0018;
      state.cameraPitch = clamp(state.cameraPitch, -1.2, 1.2);
    }
  });

  document.addEventListener("pointerdown", (event) => {
    if (state.inputMode !== "mobile") return;

    if (event.target === refs.lookPad || event.target.closest("#lookPad")) {
      state.lookTouchActive = true;
      state.lookTouchX = event.clientX;
      state.lookTouchY = event.clientY;
    }

    if (event.target.closest("#joystickBase")) {
      const rect = refs.joystickBase.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      const dx = event.clientX - centerX;
      const dy = event.clientY - centerY;
      const limit = 30;
      const length = Math.hypot(dx, dy);
      const clampLen = Math.min(length, limit);
      const angle = Math.atan2(dy, dx);
      const knobX = Math.cos(angle) * clampLen;
      const knobY = Math.sin(angle) * clampLen;
      refs.joystickKnob.style.transform = `translate(${knobX}px, ${knobY}px)`;
      state.touchMoveX = (knobX / limit) * 1.5;
      state.touchMoveY = (knobY / limit) * 1.5;
    }
  });

  document.addEventListener("pointermove", (event) => {
    if (state.lookTouchActive && state.inputMode === "mobile") {
      const dx = event.clientX - state.lookTouchX;
      const dy = event.clientY - state.lookTouchY;
      state.cameraYaw -= dx * 0.0035;
      state.cameraPitch -= dy * 0.003;
      state.cameraPitch = clamp(state.cameraPitch, -1.2, 1.2);
      state.lookTouchX = event.clientX;
      state.lookTouchY = event.clientY;
    }

    if (state.inputMode === "mobile" && event.target.closest("#joystickBase")) {
      const rect = refs.joystickBase.getBoundingClientRect();
      const centerX = rect.left + rect.width / 2;
      const centerY = rect.top + rect.height / 2;
      const dx = event.clientX - centerX;
      const dy = event.clientY - centerY;
      const limit = 30;
      const length = Math.hypot(dx, dy);
      const safeLength = Math.min(length, limit);
      const angle = Math.atan2(dy, dx);
      const knobX = Math.cos(angle) * safeLength;
      const knobY = Math.sin(angle) * safeLength;
      refs.joystickKnob.style.transform = `translate(${knobX}px, ${knobY}px)`;
      state.touchMoveX = (knobX / limit) * 1.5;
      state.touchMoveY = (knobY / limit) * 1.5;
    }
  });

  document.addEventListener("pointerup", () => {
    state.lookTouchActive = false;
    state.touchMoveX = 0;
    state.touchMoveY = 0;
    refs.joystickKnob.style.transform = "translate(-50%, -50%)";
  });

  refs.canvas.addEventListener("contextmenu", (event) => event.preventDefault());
}

function handleResize() {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
}

function handleKeyDown(event) {
  const keyMap = {
    KeyW: "forward",
    KeyS: "backward",
    KeyA: "left",
    KeyD: "right",
    ArrowLeft: "prev",
    ArrowRight: "next",
    KeyE: "interact",
    KeyF: "fullscreen",
    Escape: "escape"
  };

  const action = keyMap[event.code];

  if (action === "prev") prevSlide();
  if (action === "next") nextSlide();
  if (action === "interact") interactWithNearest();
  if (action === "fullscreen") toggleFullscreen();
  if (action === "escape") {
    if (document.fullscreenElement) document.exitFullscreen();
  }

  if (event.code === "KeyW") state.moveForward = true;
  if (event.code === "KeyS") state.moveBackward = true;
  if (event.code === "KeyA") state.moveLeft = true;
  if (event.code === "KeyD") state.moveRight = true;
}

function handleKeyUp(event) {
  if (event.code === "KeyW") state.moveForward = false;
  if (event.code === "KeyS") state.moveBackward = false;
  if (event.code === "KeyA") state.moveLeft = false;
  if (event.code === "KeyD") state.moveRight = false;
}

function prevSlide() {
  state.currentIndex = (state.currentIndex - 1 + slides.length) % slides.length;
  showSlide(state.currentIndex);
}

function nextSlide() {
  state.currentIndex = (state.currentIndex + 1) % slides.length;
  showSlide(state.currentIndex);
}

function renderSectionButtons() {
  refs.sectionNav.innerHTML = "";

  slides.forEach((slide, index) => {
    const button = document.createElement("button");
    button.textContent = slide.meta.split("·")[1]?.trim() || `بخش ${index + 1}`;
    if (index === state.currentIndex) button.classList.add("active");
    button.addEventListener("click", () => showSlide(index));
    refs.sectionNav.appendChild(button);
  });
}

function showSlide(index) {
  state.currentIndex = index;
  const slide = slides[index];
  state.activeSlide = slide;

  refs.slideMeta.textContent = slide.meta;
  refs.slideTitle.textContent = slide.title;
  refs.slideContent.innerHTML = "";

  slide.content.forEach((paragraph) => {
    const el = document.createElement("p");
    el.textContent = paragraph;
    refs.slideContent.appendChild(el);
  });

  renderSectionButtons();
  syncRegionSelection();

  if (state.mode === "presentation") {
    cameraTarget.set(...slide.camera.pos);
    cameraLookTarget.set(...slide.camera.look);
  }

  if (index === slides.length - 1) {
    refs.quizPanel.classList.remove("hidden");
  } else {
    refs.quizPanel.classList.add("hidden");
  }
}

function renderRegions() {
  refs.mapGrid.innerHTML = "";
  regions.forEach((region) => {
    const button = document.createElement("button");
    button.className = "region-btn";
    button.textContent = region.name;
    button.addEventListener("click", () => {
      refs.regionInfo.textContent = region.info;
      const targetIndex = slides.findIndex((slide) => slide.id === region.target);
      if (targetIndex >= 0) showSlide(targetIndex);
      document.querySelectorAll(".region-btn").forEach((el) => el.classList.remove("active"));
      button.classList.add("active");
    });
    refs.mapGrid.appendChild(button);
  });
}

function syncRegionSelection() {
  const currentName = slides[state.currentIndex].map;
  const activeRegion = regions.find((region) => region.name === currentName || region.target === slides[state.currentIndex].id);
  if (activeRegion) {
    refs.regionInfo.textContent = activeRegion.info;
  }

  document.querySelectorAll(".region-btn").forEach((button) => {
    const isActive = button.textContent.trim() === (activeRegion ? activeRegion.name : "");
    button.classList.toggle("active", isActive);
  });
}

function renderComparison() {
  refs.compareChart.innerHTML = "";
  const max = Math.max(...comparisonData.map((item) => item.value));

  comparisonData.forEach((item) => {
    const row = document.createElement("div");
    row.className = "chart-row";

    const label = document.createElement("span");
    label.className = "chart-label";
    label.textContent = item.label;

    const barWrap = document.createElement("div");
    barWrap.className = "bar-bg";

    const bar = document.createElement("span");
    bar.className = "bar-fill";
    bar.style.width = `${(item.value / max) * 100}%`;

    const value = document.createElement("span");
    value.textContent = `${item.value}%`;

    barWrap.appendChild(bar);
    row.append(label, barWrap, value);
    refs.compareChart.appendChild(row);
  });
}

function interactWithNearest() {
  let closest = null;
  let closestDist = Infinity;

  interactiveMarkers.forEach((marker) => {
    const distance = marker.position.distanceTo(camera.position);
    if (distance < closestDist) {
      closest = marker;
      closestDist = distance;
    }
  });

  if (closest && closestDist < 5) {
    const index = closest.userData.slide - 1;
    showSlide(Math.max(0, Math.min(slides.length - 1, index)));
    showToast(`تعامل: ${closest.userData.label}`);
  } else {
    showToast("اشیای قابل تعامل نزدیک نیستند");
  }
}

function toggleFullscreen() {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen().catch(() => {});
  } else {
    document.exitFullscreen();
  }
}

function updateMovement(delta) {
  const moveSpeed = state.mode === "explore" ? 8.5 : 0.2;
  const cameraForward = new THREE.Vector3();
  camera.getWorldDirection(cameraForward);
  cameraForward.y = 0;
  cameraForward.normalize();

  const right = new THREE.Vector3().crossVectors(cameraForward, new THREE.Vector3(0, 1, 0)).normalize();
  const move = new THREE.Vector3();

  if (state.moveForward) move.add(cameraForward);
  if (state.moveBackward) move.sub(cameraForward);
  if (state.moveLeft) move.sub(right);
  if (state.moveRight) move.add(right);

  if (state.inputMode === "mobile") {
    const joystickX = state.touchMoveX;
    const joystickY = state.touchMoveY;

    movementVector.set(joystickX, 0, joystickY);
    movementVector.applyAxisAngle(new THREE.Vector3(0, 1, 0), -state.cameraYaw);
    state.worldMoveX = movementVector.x;
    state.worldMoveZ = movementVector.z;
  }

  const movementX = state.inputMode === "mobile" ? state.worldMoveX : move.x;
  const movementZ = state.inputMode === "mobile" ? state.worldMoveZ : move.z;

  if (movementX || movementZ) {
    camera.position.x += movementX * moveSpeed * delta;
    camera.position.z += movementZ * moveSpeed * delta;
    camera.position.x = clamp(camera.position.x, -30, 30);
    camera.position.z = clamp(camera.position.z, -30, 30);
  }
}

function updateCamera(delta) {
  if (state.paused) return;

  if (state.mode === "presentation") {
    camera.position.lerp(cameraTarget.clone().add(new THREE.Vector3(0, 1.7, 0)), 0.04);
    camera.lookAt(cameraLookTarget);
  } else {
    camera.rotation.order = "YXZ";
    camera.rotation.y = state.cameraYaw;
    camera.rotation.x = state.cameraPitch;
    camera.position.y = 1.8;

    updateMovement(delta);
  }
}

function animate() {
  requestAnimationFrame(animate);

  const delta = 1 / 60;
  if (!state.started) {
    renderer.render(scene, camera);
    return;
  }

  updateCamera(delta);
  renderer.render(scene, camera);
}

const initialMode = detectInputMode();
state.inputMode = initialMode;
applyInputMode(initialMode);
setupScene();
