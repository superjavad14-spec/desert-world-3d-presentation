const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

const showToast = (message) => {
  refs.toast.textContent = message;
  refs.toast.classList.remove("hidden");
  clearTimeout(showToast.timeout);
  showToast.timeout = setTimeout(() => refs.toast.classList.add("hidden"), 1800);
};

function detectInputMode() {
  const coarse = window.matchMedia("(pointer: coarse)").matches || navigator.maxTouchPoints > 0;
  const hasTouch = "ontouchstart" in window || navigator.maxTouchPoints > 0;
  const manual = localStorage.getItem("desertInputMode");

  if (manual === "desktop" || manual === "mobile") return manual;

  if (coarse && hasTouch) return "mobile";
  return "desktop";
}

function applyInputMode(mode) {
  state.inputMode = mode;

  if (mode === "desktop") {
    refs.desktopControls.classList.remove("hidden");
    refs.mobileControls.classList.add("hidden");
  } else {
    refs.desktopControls.classList.add("hidden");
    refs.mobileControls.classList.remove("hidden");
  }

  if (mode === "mobile") {
    showToast("حالت موبایل فعال شد");
  }

  if (mode === "desktop") {
    showToast("حالت کامپیوتر فعال شد");
  }
}

function setMode(mode) {
  state.mode = mode;
  refs.modeLabel.textContent = mode === "presentation" ? "حالت ارائه" : "حالت اکتشاف";
  refs.modeToggleBtn.textContent = mode === "presentation" ? "ورود به اکتشاف" : "ورود به ارائه";
}

function buildWorld() {
  worldRoot = new THREE.Group();
  scene.add(worldRoot);

  const groundGeometry = new THREE.BoxGeometry(100, 2, 100);
  const groundMaterial = new THREE.MeshStandardMaterial({ color: 0xd6a45a, flatShading: true });
  const ground = new THREE.Mesh(groundGeometry, groundMaterial);
  ground.position.y = -1;
  ground.receiveShadow = true;
  worldRoot.add(ground);

  const dunePositions = [
    [-18, 1.2, 10], [-10, 1.6, -12], [8, 1.4, 14], [18, 1.1, -10], [0, 1.7, 17],
    [-12, 1.5, 20], [15, 1.1, 6], [12, 1.6, -18], [-22, 1.4, -6], [0, 1.5, -18]
  ];

  dunePositions.forEach(([x, y, z], idx) => {
    const dune = new THREE.Mesh(
      new THREE.BoxGeometry(8 + (idx % 3) * 2.5, 2 + (idx % 4) * 0.5, 7 + (idx % 2) * 2.6),
      new THREE.MeshStandardMaterial({ color: 0xe3b366, flatShading: true })
    );
    dune.position.set(x, y, z);
    dune.rotation.y = idx * 0.8;
    dune.castShadow = true;
    dune.receiveShadow = true;
    worldRoot.add(dune);
  });

  const rockData = [
    { x: 10, y: 0.8, z: 7, sx: 2.4, sy: 1.7, sz: 2.1 },
    { x: -10, y: 0.9, z: 12, sx: 2, sy: 1.8, sz: 1.7 },
    { x: -12, y: 0.8, z: -8, sx: 2.8, sy: 1.6, sz: 2.2 },
    { x: 18, y: 0.7, z: -15, sx: 3.2, sy: 1.9, sz: 2.7 },
    { x: -18, y: 0.7, z: -16, sx: 2.4, sy: 1.4, sz: 2.1 },
    { x: 0, y: 0.9, z: -10, sx: 3, sy: 1.8, sz: 2.5 }
  ];

  rockData.forEach((rock) => {
    const mesh = new THREE.Mesh(
      new THREE.BoxGeometry(rock.sx, rock.sy, rock.sz),
      new THREE.MeshStandardMaterial({ color: 0x6f6c6c, flatShading: true })
    );
    mesh.position.set(rock.x, rock.y, rock.z);
    mesh.rotation.y = rock.x * 0.23;
    mesh.castShadow = true;
    mesh.receiveShadow = true;
    worldRoot.add(mesh);
  });

  const camp = createStructure({ x: 5, y: 0.7, z: 2, w: 5, h: 2.2, d: 4, color: 0xb06a3d, label: "پایگاه اکتشاف" });
  const hall = createStructure({ x: -8, y: 0.75, z: -3, w: 6, h: 3.1, d: 5, color: 0x9b7049, label: "تالار آموزشی" });
  const observatory = createStructure({ x: -2, y: 0.8, z: -9, w: 4.2, h: 2.5, d: 4.2, color: 0x8b5f3a, label: "رصدخانه" });
  const gate = createStructure({ x: 12, y: 0.85, z: -3, w: 2.5, h: 2.8, d: 2.4, color: 0x7a4d2d, label: "دروازه" });

  worldRoot.add(camp.group, hall.group, observatory.group, gate.group);

  const markers = [
    { label: "بیابان چیست؟", position: [12, 1.2, 6], slide: 1 },
    { label: "شکل‌گیری", position: [-10, 1.2, 8], slide: 2 },
    { label: "نقشه جهان", position: [0, 1.5, 18], slide: 3 },
    { label: "صحرای بزرگ", position: [16, 1.6, 10], slide: 4 },
    { label: "گُبی", position: [-19, 1.6, 3], slide: 5 },
    { label: "آتاکاما", position: [22, 1.7, -10], slide: 6 },
    { label: "استرالیا", position: [-14, 1.6, -14], slide: 7 },
    { label: "بیابان‌های سرد", position: [0, 1.6, 18], slide: 8 },
    { label: "زندگی", position: [-8, 1.5, 10], slide: 9 },
    { label: "مقایسه", position: [10, 1.5, 10], slide: 10 },
    { label: "دانستنی‌ها", position: [6, 1.7, 15], slide: 11 },
    { label: "جمع‌بندی", position: [0, 2.1, 14], slide: 12 }
